<?xml version="1.0" encoding="utf-8"?>
<webParts>
  <webPart xmlns="http://schemas.microsoft.com/WebPart/v3">
    <metaData>
      <type name="Sazmanyar.GIS.ShowAllMapSheetInfo.ShowAllMapSheetInfo, $SharePoint.Project.AssemblyFullName$" />
      <importErrorMessage>$Resources:core,ImportErrorMessage;</importErrorMessage>
    </metaData>
    <data>
      <properties>
        <property name="Title" type="string">برگه‌های نقشه (MapSheets)</property>
        <property name="Description" type="string">نمایش و جستجوی برگه‌های نقشهء کارفرما (سطح واقعی پروژه‌های PWA) و بارگذاری Shapefile به‌صورت ZIP</property>
      </properties>
    </data>
  </webPart>
</webParts>
